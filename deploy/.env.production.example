# Copy this file to /var/www/moats-pro/.env.production on the Hetzner server
# (NOT committed). Both deploy.sh (Vite build) and ecosystem.config.cjs (PM2
# runtime) read from it. After editing, re-run:
#   sudo -u moats bash /var/www/moats-pro/deploy/deploy.sh

# ---- API server (runtime, NOT baked into bundle) ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/moats_pro

# ---- Vite build-time (baked into the JS bundle) ----
# Li.Fi key — used as `x-lifi-api-key` for Li.Fi quote calls.
VITE_LIFI_API_KEY=
# ONLY set to 1 AFTER you've registered "moats-pro" on https://portal.li.fi/
# with FEE_WALLET (0xe789…30C6) as the fee collector. Until then, Li.Fi
# rejects every quote with "Integrator 'moats-pro' is not configured" and
# the swap UI silently drops the fee param. Manual 2-tx fee fallback works
# either way.
VITE_LIFI_INTEGRATED_FEE=
VITE_KYBERSWAP_CLIENT_ID=moats-pro
# 0x Swap API key — required for the 0x router. Get one at https://0x.org
# (free tier works). 0x v2 permit2 supports native integrator fees
# (swapFeeRecipient/swapFeeBps/swapFeeToken) — 100% of the 33 bps is sent
# to FEE_WALLET in-tx, no rev share with 0x.
VITE_0X_API_KEY=
